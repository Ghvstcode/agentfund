# AgentFund server configuration.
#
# Nothing here is required for a first run: `docker compose up` works with no .env at all
# (dev login on, webhook secret generated). Copy this file to .env and fill it in to run a
# real instance. Empty values mean "use the default". The server validates everything at boot
# and exits with a list of what is wrong.

# ── Identity ─────────────────────────────────────────────────────────────────────────────
# Software name shown as `meta.app` and in page titles. Change it to rebrand a fork.
APP_NAME=AgentFund
# Display name and one-line description of THIS instance. They only seed the database on the
# first boot; afterwards an admin edits them in the UI (PATCH /v1/admin/instance).
INSTANCE_NAME=
INSTANCE_DESCRIPTION=
# Public URL of the instance, no trailing slash. It is the prefix of every global id
# (<BASE_URL>/<slug>, <BASE_URL>/u/<handle>), the OAuth callback and every link in feeds and
# OG tags. Default: http://localhost:<HOST_PORT or PORT>.
BASE_URL=

# ── Network ──────────────────────────────────────────────────────────────────────────────
# Port the server listens on inside the container / process.
PORT=8787
# Host port docker compose publishes the app on.
HOST_PORT=8787
# Set to true only behind a reverse proxy you control: the client IP for rate limiting is then
# taken from X-Forwarded-For.
TRUST_PROXY=false
# Header your edge proxy sets to the client IP and overwrites if the client sent one (Fly.io:
# fly-client-ip). Takes precedence over TRUST_PROXY; X-Forwarded-For can be forged by clients.
CLIENT_IP_HEADER=
# Extra browser origins allowed to call the API with a token and to be OAuth redirect targets
# (comma-separated, e.g. an independently hosted UI). The instance's own origin is always
# allowed. Default: empty, or http://localhost:5173 while dev login is on.
WEB_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────────────────
# Postgres 16+. Migrations are applied automatically on boot. In docker compose this defaults
# to the bundled postgres service; outside compose it is the one required variable.
DATABASE_URL=
# Password of the bundled compose Postgres (only used by docker-compose.yml).
POSTGRES_PASSWORD=agentfund

# ── Login ────────────────────────────────────────────────────────────────────────────────
# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
#   <BASE_URL>/v1/auth/github/callback
# Requested scopes are read:user and user:email; the server never keeps the GitHub token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Development login: POST /v1/auth/dev {handle} logs in as anyone, no password.
# Default: true while GitHub OAuth is not configured (with a loud warning in the log),
# false once it is. Never leave it on for a public instance.
AUTH_DEV_LOGIN=
# Comma-separated handles that are admins. When empty, the first user to log in is the admin.
ADMIN_HANDLES=

# ── CI confirmation ──────────────────────────────────────────────────────────────────────
# Every project has its OWN webhook secret, generated at creation. Its maintainer finds the
# payload URL and secret in the UI (GET /v1/projects/<slug>/webhook) and can rotate it; a
# project's secret only ever validates CI results for that project. Nothing to configure here.
#
# Optional operator-level secret: when set (16+ characters), a webhook signed with it is
# accepted for ANY project on the instance — for an organisation-wide GitHub webhook you
# control. It is never shown to maintainers or returned by the API. Leave empty unless you
# need that; there is no generated instance-wide secret any more.
WEBHOOK_SECRET=
# Also poll the GitHub REST API for check runs and PR state of pending reports, so an instance
# GitHub cannot reach (localhost, a private network) still confirms deliveries.
CI_POLL=false
# Seconds between poll rounds.
CI_POLL_INTERVAL_SECONDS=30
# Optional token for the poller. Without it GitHub allows 60 requests/hour per IP; any token
# (no scopes needed for public repos) raises that to 5000.
GITHUB_TOKEN=

# ── Indexing ─────────────────────────────────────────────────────────────────────────────
# Where bare clones of project repos live (DATA_DIR/repos). A volume in compose.
DATA_DIR=./data
# Seconds between re-index rounds for projects that follow their base branch. 0 disables the
# timer (push webhooks and manual re-pins still index).
INDEX_INTERVAL_SECONDS=60
# Allow file:// repository URLs. For tests and local end-to-end runs only.
ALLOW_FILE_REPOS=false

# ── Web UI ───────────────────────────────────────────────────────────────────────────────
# Directory of the built SPA (web/dist). The Docker image sets this to /app/web. If it has no
# index.html the server shows a small placeholder page and the API works as usual.
WEB_DIST=../web/dist
# Docker build only: auto = build web/ if possible, required = fail the build if not, skip.
WEB_BUILD=auto

# ── Links and looks ──────────────────────────────────────────────────────────────────────
# Published as `meta.links` so UIs can point donors at the right places.
# Where this instance's software source lives. Default: https://github.com/ghvstcode/agentfund
SOURCE_URL=
# Shell one-liner that installs the worker CLI. Default:
#   curl -fsSL https://raw.githubusercontent.com/ghvstcode/agentfund/main/scripts/install.sh | sh
# (the released binaries; set a `git clone` and build line to install from source instead)
INSTALL_COMMAND=
# Documentation URL. Omitted from `meta.links` when empty.
DOCS_URL=
# The one accent colour of generated /og/<slug>.png cards (progress bar), as #rrggbb.
# Default: #2563eb
OG_ACCENT=

# ── Tuning ───────────────────────────────────────────────────────────────────────────────
# Seconds between lease-expiry sweeps.
SWEEP_INTERVAL_SECONDS=15
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Requests per minute per client IP and per credential on /v1 (0 = unlimited), and the
# stricter per-IP limit on /v1/auth/*. Counted per server process.
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30
# Postgres connections per server process.
DB_POOL_MAX=10
# debug | info | warn | error. Logs are JSON lines on stdout; secrets are never logged.
LOG_LEVEL=info
